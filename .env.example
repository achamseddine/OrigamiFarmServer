# Copy to .env and fill in real values for your environment.
# Never commit a real .env file.

ENVIRONMENT=local

# --- Control plane database (tenants, plans, entitlements, devices, audit, billing metadata) ---
CONTROL_DATABASE_URL=postgresql+psycopg://origami:origami_dev_password@localhost:5433/origami_control

# --- Shared tenant farm-data database (RLS-isolated operational data) ---
TENANT_DATABASE_URL=postgresql+psycopg://origami:origami_dev_password@localhost:5434/origami_tenant_shared

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible; MinIO for local dev) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=origami
S3_SECRET_ACCESS_KEY=origami_dev_password
S3_BUCKET_NAME=origami-server-local
S3_REGION=us-east-1

# --- Identity provider (OIDC/OAuth2) ---
OIDC_ISSUER=http://localhost:8081/realms/origami
OIDC_AUDIENCE=origami-server
OIDC_JWKS_URL=http://localhost:8081/realms/origami/protocol/openid-connect/certs
# Set to true only for local dev without a running IdP. Never enable in staging/production.
AUTH_DEV_MODE=false

# --- License lease signing (asymmetric; private key never leaves the server) ---
LICENSE_LEASE_PRIVATE_KEY_PATH=./infrastructure/keys/license_lease_private.pem
LICENSE_LEASE_PUBLIC_KEY_PATH=./infrastructure/keys/license_lease_public.pem
LICENSE_LEASE_POLICY_VERSION=1
LICENSE_LEASE_DEFAULT_TTL_HOURS=72

# --- App ---
APP_SECRET_KEY=change-me-in-every-environment
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Admin web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
